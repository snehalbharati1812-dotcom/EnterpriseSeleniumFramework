<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Regression Suite">

    <!-- Listener to trigger ExtentReports -->
    <listeners>
        <listener class-name="com.orangehrm.listeners.TestListener"/>
    </listeners>

    <!-- Group Filter: Include all regression tests -->
    <groups>
        <run>
            <include name="regression"/>
        </run>
    </groups>

    <test name="Full Regression Suite">
        <classes>
            <class name="com.orangehrm.tests.LoginTest"/>
            <class name="com.orangehrm.tests.DashboardTest"/>
            <class name="com.orangehrm.tests.AdminTest"/>
            <class name="com.orangehrm.tests.PIMTest"/>
            <class name="com.orangehrm.tests.LeaveTest"/>
            <class name="com.orangehrm.tests.RecruitmentTest"/>
        </classes>
    </test>
</suite>