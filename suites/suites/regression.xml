<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Full Regression Suite">
    <listeners>
        <listener class-name="com.company.framework.listeners.TestListener"/>
    </listeners>

    <test name="Regression Executions">
        <!-- Runs only tests tagged with groups = {"regression"} -->
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>

        <!-- Scans the entire package for test classes -->
        <packages>
            <package name="com.company.framework.tests"/>
        </packages>
    </test>
</suite>